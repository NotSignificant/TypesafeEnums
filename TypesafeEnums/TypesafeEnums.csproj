<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Version>1.0.2</Version>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>TypesafeEnums im Java-Stil</Title>
		<Authors>Hartmut Pohl (NotSignificant)</Authors>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<Copyright>Copyright © 2026 H. Pohl</Copyright>
		<PackageProjectUrl>https://github.com/NotSignificant/TypesafeEnums</PackageProjectUrl>
		<RepositoryUrl>https://github.com/NotSignificant/TypesafeEnums.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Warnungen bei leerem Switch-Block oder fehlenden Fällen hinzufefügt</PackageReleaseNotes>
		<PackageTags>TypesafeEnums Enum Java CSharp CSharp-Enums</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Java-Like TypesafeEnums für .NET mit Switch auf Typ statt auf string oder int</Description>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<AnalysisLevel>none</AnalysisLevel>
		<PackageId>$(AssemblyName).NET</PackageId>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\TypesafeEnums.Analyzers\TypesafeEnums.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

		<None Include="..\TypesafeEnums.Analyzers\bin\$(Configuration)\netstandard2.0\TypesafeEnums.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
